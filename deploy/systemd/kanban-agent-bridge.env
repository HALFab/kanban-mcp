# Environment for kanban-agent-bridge

# Inbox directory written by @kanban-mcp/db when tasks are assigned to AGENT
MCP_KANBAN_INBOX_DIR=/home/patrick/.openclaw/kanban-inbox

# kanban-mcp web-server API base
MCP_KANBAN_API_BASE_URL=http://127.0.0.1:3000/api

# OpenClaw Gateway
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_AGENT_ID=main

# Set this on the host (root-owned file under /etc) when installing:
# OPENCLAW_HOOKS_TOKEN=...

# Optional
KANBAN_BRIDGE_NAME=Kanban
KANBAN_BRIDGE_LOG=1
